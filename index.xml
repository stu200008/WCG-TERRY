<tabs elevation="4" scrollable="true" background="color(background)">
    <for array="$tabs">
        <tab title="${item.title}">
            <switch>
                <if candidate="isNotNull(${item.subtabs})">
                    <widget src="subtabs" data="$item"/>
                </if>
                <else>
                    <widget src="main" data="$item"/>
                </else>
            </switch>
        </tab>
    </for>
</tabs>
